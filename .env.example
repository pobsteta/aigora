# AIGORA (Local Edition, RStudio) - Variables d'environnement
# Copie ce fichier en .env (dans RStudio : aigora_env()) et remplis seulement ce dont tu as besoin.
#
# LE CŒUR FONCTIONNE SANS AUCUNE CLÉ. Il suffit de Claude Code connecté à ton abonnement Claude.
# Jamais de mot de passe principal ici : seulement des mots de passe d'application et des jetons API.
# Ce fichier est ignoré par git. Ne le partage jamais.

# ============================================================
# Général
# ============================================================
TIMEZONE=Europe/Paris          # fuseau des heures d'agenda (création d'événements, tâches)

# ============================================================
# kSuite (Infomaniak) - guide pas à pas : docs/KSUITE.md
# ============================================================

# --- Mail (IMAP/SMTP) : skills email-digest, email-assistant, research-lead
# Mot de passe d'APPAREIL de l'adresse (différent du mot de passe d'application de l'agenda) :
# Manager > Service Mail > domaine > adresse > Appareils > Ajouter un appareil
# KSUITE_MAIL_USER=prenom.nom@ton-domaine.ch
# KSUITE_MAIL_PASSWORD=
# KSUITE_MAIL_FROM=Prénom Nom <prenom.nom@ton-domaine.ch>   # optionnel
# KSUITE_DRAFTS_FOLDER=Drafts                               # optionnel, détecté automatiquement
# Serveurs (valeurs par défaut, à ne changer qu'en cas de besoin)
# KSUITE_IMAP_HOST=mail.infomaniak.com
# KSUITE_IMAP_PORT=993
# KSUITE_SMTP_HOST=mail.infomaniak.com
# KSUITE_SMTP_PORT=587

# --- Agenda (CalDAV) : skills scrum-master, meeting-prep, scheduler
# Identifiant court (ex. AB12345) : config.infomaniak.com > Mon agenda > Synchronisation manuelle
# Mot de passe d'APPLICATION du compte : manager.infomaniak.com/v3/profile/application-password
# KSUITE_DAV_USER=
# KSUITE_DAV_PASSWORD=
# KSUITE_CALDAV_URL=https://sync.infomaniak.com

# --- Contacts (CardDAV) : mêmes identifiants que l'agenda (KSUITE_DAV_USER / PASSWORD)
# KSUITE_CARDDAV_URL=https://sync.infomaniak.com

# --- kDrive : dossier synchronisé par l'application kDrive de bureau (toutes offres)
# Rempli automatiquement par aigora_kdrive() dans la console R
# KDRIVE_LOCAL_PATH=

# --- kChat : webhook entrant. Icône « Nouveau » (+) à côté du nom de l'organisation kChat >
# Intégrations > Webhooks entrants > Ajouter (peut demander les droits d'administrateur)
# KCHAT_WEBHOOK_URL=
# KCHAT_USERNAME=AIGORA            # nom affiché sur les messages (sinon « webhook »)

# --- Serveurs MCP officiels Infomaniak (Mail, Agenda, kDrive, kChat, Contacts)
# Jeton : manager.infomaniak.com > Développeurs > Jetons API
# Scopes possibles : workspace:mail workspace:calendar user_info drive kchat contacts
# Puis : aigora_mcp(simulation = FALSE) dans la console R
# INFOMANIAK_TOKEN=
# KDRIVE_ID=              # le nombre dans l'URL kdrive.infomaniak.com/app/drive/123456/...
# KCHAT_TEAM_NAME=        # <equipe> dans https://<equipe>.kchat.infomaniak.com
# Jetons séparés par service (facultatif, sinon INFOMANIAK_TOKEN est utilisé)
# KSUITE_MAIL_TOKEN=
# KSUITE_CALENDAR_TOKEN=
# KDRIVE_TOKEN=
# KCHAT_TOKEN=
# KSUITE_CONTACT_TOKEN=

# --- Serveur MCP communautaire (kMeet, Chk, kPaste, tâches) : opt-in, voir docs/KSUITE.md
# KSUITE_EXTRA_MCP=1

# ============================================================
# Applications locales : RStudio et QGIS (optionnel) - docs/RSTUDIO-QGIS.md
# ============================================================

# Session R visible par AIGORA (paquet btw de Posit). Activer avec aigora_r_mcp(TRUE)
# AIGORA_R_MCP=1
# Groupes d'outils btw (par défaut : docs,pkg,env,sessioninfo,cran ; ajouter run = exécuter du R dans ta session)
# AIGORA_R_MCP_TOOLS=docs,pkg,env,sessioninfo,cran
# AIGORA_RSCRIPT=          # chemin de Rscript, seulement si aigora_mcp() lancé hors de R ne le trouve pas

# QGIS (serveur qgis-mcp + extension QGIS « QGIS MCP »). Activer avec aigora_qgis_mcp(TRUE)
# AIGORA_QGIS_MCP=1
# AIGORA_QGIS_TOOL_MODE=compound   # compound = 27 outils groupés (recommandé), granular = 125 outils
# AIGORA_QGIS_PORT=9876
# AIGORA_QGIS_TOKEN=               # secret partagé (ordinateur partagé) : même valeur dans QGIS,
#                                # Préférences > Options > Système > Environnement : QGIS_MCP_TOKEN

# Odoo CRM (leads, opportunités, pipeline) - docs/ODOO.md
# Rempli par aigora_odoo_configurer() dans la console R
# ODOO_URL=http://localhost:8069          # ou https://monentreprise.odoo.com
# ODOO_DB=                                # nom de la base (obligatoire avant Odoo 19 ou si plusieurs bases)
# ODOO_LOGIN=                             # identifiant Odoo, souvent l'e-mail (nécessaire avant Odoo 19)
# ODOO_API_KEY=                           # Préférences > Sécurité du compte > Nouvelle clé API
# ODOO_API=auto                           # auto | json2 (Odoo 19+) | xmlrpc (Odoo 18 et avant)

# QFieldCloud (relevés terrain QField) - docs/QFIELDCLOUD.md
# Rempli par aigora_qfieldcloud_login() dans la console R (jamais de mot de passe ici)
# QFIELDCLOUD_URL=https://app.qfield.cloud/api/v1/
# QFIELDCLOUD_TOKEN=

# ============================================================
# IA open source (optionnel) - docs/MEMORY-UPGRADE.md
# ============================================================

# Mémoire avancée locale (mem0 + Qdrant + Ollama) : aucune clé, juste un identifiant
# MEM0_USER_ID=ton_prenom

# Infomaniak AI Tools (modèles open source hébergés en Suisse, API compatible OpenAI)
# Utilisé seulement si tu décommentes le bloc Infomaniak de .claude/skills/memory/references/mem0_config.yaml
# INFOMANIAK_AI_TOKEN=
# INFOMANIAK_AI_BASE_URL=https://api.infomaniak.com/2/ai/<PRODUCT_ID>/openai/v1

# ============================================================
# Connecteurs open source auto-hébergés (optionnel) - docs/CONNECTEURS-OPEN-SOURCE.md
# ============================================================

# Recherche web SearXNG (remplace Perplexity)
# SEARXNG_URL=http://localhost:8080
